# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ────────────────────────────────────────
/.next/
/out/
/build

# ── Testing / coverage ──────────────────────────────────────────
/coverage

# ── Environment variables ───────────────────────────────────────
.env
.env.*
!.env.example

# ── OS / editor artifacts ───────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
!.vscode/extensions.json

# ── Debug / log files ───────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript ──────────────────────────────────────────────────
*.tsbuildinfo

# ── Vercel (not used here, but kept as a safety net) ────────────
.vercel

# ── Tailwind / PostCSS cache ────────────────────────────────────
.tailwind-cache

